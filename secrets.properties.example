# Copy this file to secrets.properties and fill in the real URLs (must be https://). The
# generateApiEndpoints Gradle task AES/GCM-encrypts these into GeneratedApiEndpoints.java
# (git-ignored, random key per build) - APIUtils.java itself is never modified by the build.
api.memberHud=https://your-api.example.com/users
api.highway=https://your-api.example.com/
api.status=https://your-api.example.com/
api.highwayStatus=https://your-api.example.com/status
api.cape=https://your-api.example.com/capes
api.capePost=https://your-api.example.com/capes/set
api.capeIndex=https://your-website.example.com/cape/index
api.kits=https://your-api.example.com/kits

# Member-gated updater API URL and public signing key. Empty values disable updates.
api.updater=
update.publicKey=
